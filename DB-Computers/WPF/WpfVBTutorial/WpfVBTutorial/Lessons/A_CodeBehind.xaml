<Window x:Class="A_CodeBehind"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVBTutorial"
        mc:Ignorable="d"
        Title="A_CodeBehind" Height="450" Width="800">
    <Grid>
        <!-- Example of label and declaring a Control -->
        <TextBlock x:Name="tbHello" Text="Hello World" FontSize="50" />
        <!-- Example of Button and Click Event-->
        <Button x:Name="btnRun" Content="Run" Width="100" Height="50" 
                HorizontalAlignment="Center" FontSize="25" Click="btnRun_Click"/>
    </Grid>
</Window>
