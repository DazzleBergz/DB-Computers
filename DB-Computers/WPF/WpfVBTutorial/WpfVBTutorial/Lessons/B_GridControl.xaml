<Window x:Class="B_GridControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVBTutorial"
        mc:Ignorable="d"
        Title="B_GridControl" Height="450" Width="800">
    <!-- Window only allow one content, so we use grid as default-->
    <Grid>
        <!-- Rows and Columns Element Properties -->
        <Grid.RowDefinitions>
            <!--Defining propert heights-->
            <RowDefinition Height="15*"/> <!--this is like 15%-->
            <RowDefinition Height="75*"/> <!--this is like 75%-->
            <RowDefinition Height="5*"/> <!--this is like 5%-->
        </Grid.RowDefinitions>
        <!--
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        -->
        
        <!-- This is by defaul on row 0, column 0 -->
        <Rectangle Fill="Blue"/>
        <!-- Define Row and Column -->
        <!-- <Rectangle Grid.Column="1" Grid.Row="1" Fill="Red"/> -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".2*"/>
                <ColumnDefinition Width=".6*"/>
                <ColumnDefinition Width=".2*"/>
            </Grid.ColumnDefinitions>
        </Grid>
        <Rectangle Grid.Row="2" Fill="Red"/>
    </Grid>
</Window>
