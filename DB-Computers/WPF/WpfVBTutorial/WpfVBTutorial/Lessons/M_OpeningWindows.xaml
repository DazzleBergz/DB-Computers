<Window x:Class="M_OpeningWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVBTutorial"
        mc:Ignorable="d"
        Title="M_OpeningWindows" Height="300" Width="300">
    <Grid>
        <StackPanel>
            <Button x:Name="btnNormal" Width="100" Height="40" Content="Normal" Margin="5"/>
            <Button x:Name="btnModal" Width="100" Height="40" Content="Modal" Margin="5"/>
            <TextBox x:Name="txtInput" Width="200" Height="40" FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>
